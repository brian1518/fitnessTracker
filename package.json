{
  "name": "lantern-training",
  "version": "1.0.0",
  "private": true,
  "description": "Green Lantern inspired workout journal",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.js",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "test": "node --env-file-if-exists=.env --test tests/*.test.js",
    "check": "node scripts/check.js",
    "build": "node scripts/check.js",
    "test:browser": "node scripts/run-browser-test.js",
    "lint": "prettier --check src scripts tests README.md docs package.json",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "build:pages": "node scripts/build-pages.js"
  },
  "engines": {
    "node": ">=22.15"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "lucide": "^1.70.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10"
  }
}
