DATABASE_MODE=embedded
PORT=3000
# Set DATABASE_MODE=postgres for a separate PostgreSQL server.
DATABASE_URL=postgresql://username:password@localhost:5432/lantern_training
# Optional. AI is disabled until explicitly enabled with a key.
AI_ENABLED=false
XAI_API_KEY=
XAI_MODEL=grok-4.7
AI_DAILY_LIMIT=10
# Use your exact public origin when deploying behind HTTPS.
# APP_ORIGIN=https://your-domain.example
# NODE_ENV=production

# Render production deployment:
# HOST=0.0.0.0
# TRUST_PROXY=1
# APP_ORIGIN=https://brian1518.github.io
# DATABASE_MODE=postgres
# DATABASE_URL comes from the hosted PostgreSQL database, never from frontend config.
